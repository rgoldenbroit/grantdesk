# Add these in Vercel (Project → Settings → Environment Variables), then run: vercel env pull .env.local
RESEARCH_OFFICE_API_URL=https://research-office-api-xxxxx.us-east4.run.app   # all environments
NCBI_EMAIL=you@example.com                                                   # all environments
SESSION_SECRET=generate-with-openssl-rand-base64-32                          # all environments
DEMO_PASSWORD=pick-a-demo-password                                           # all environments
DEV_LAB_ID=protein-design                                                    # Development only
